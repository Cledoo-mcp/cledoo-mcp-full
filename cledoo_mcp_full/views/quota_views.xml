<odoo>
  <record id="mcp_quota_view_list" model="ir.ui.view">
    <field name="name">mcp.quota.list</field>
    <field name="model">mcp.quota</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="name"/>
        <field name="principal_pattern"/>
        <field name="daily_calls"/>
        <field name="daily_writes"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>
  <record id="action_mcp_quota" model="ir.actions.act_window">
    <field name="name">MCP Quotas</field>
    <field name="res_model">mcp.quota</field>
    <field name="view_mode">list</field>
  </record>
</odoo>

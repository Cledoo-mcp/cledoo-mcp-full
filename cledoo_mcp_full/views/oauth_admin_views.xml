<odoo>
  <record id="view_mcp_oauth_token_list" model="ir.ui.view">
    <field name="name">mcp.oauth.token.list</field>
    <field name="model">mcp.oauth.token</field>
    <field name="arch" type="xml">
      <list string="Connected AI clients" create="false" import="false">
        <field name="client_name"/>
        <field name="user_id"/>
        <field name="expires_at"/>
        <field name="revoked"/>
        <button name="action_revoke" type="object" string="Revoke"
                icon="fa-ban" invisible="revoked"/>
      </list>
    </field>
  </record>

  <record id="action_mcp_oauth_token" model="ir.actions.act_window">
    <field name="name">Connected AI clients</field>
    <field name="res_model">mcp.oauth.token</field>
    <field name="view_mode">list</field>
    <field name="domain">[('kind','=','access')]</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>

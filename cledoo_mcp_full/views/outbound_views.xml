<odoo>
  <record id="mcp_outbound_confirmation_view_list" model="ir.ui.view">
    <field name="name">mcp.outbound.confirmation.list</field>
    <field name="model">mcp.outbound.confirmation</field>
    <field name="arch" type="xml">
      <list create="false" edit="false">
        <field name="create_date"/>
        <field name="approver_id"/>
        <field name="expires_at"/>
        <field name="used"/>
      </list>
    </field>
  </record>
  <record id="action_mcp_outbound_confirmation" model="ir.actions.act_window">
    <field name="name">Outbound confirmations</field>
    <field name="res_model">mcp.outbound.confirmation</field>
    <field name="view_mode">list</field>
  </record>
</odoo>

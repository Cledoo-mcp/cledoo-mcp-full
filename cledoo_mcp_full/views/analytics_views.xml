<odoo>
  <record id="mcp_audit_report_view_graph" model="ir.ui.view">
    <field name="name">mcp.audit.report.graph</field>
    <field name="model">mcp.audit.report</field>
    <field name="arch" type="xml">
      <graph type="line" sample="1">
        <field name="date" interval="day"/>
        <field name="calls" type="measure"/>
      </graph>
    </field>
  </record>
  <record id="mcp_audit_report_view_pivot" model="ir.ui.view">
    <field name="name">mcp.audit.report.pivot</field>
    <field name="model">mcp.audit.report</field>
    <field name="arch" type="xml">
      <pivot sample="1">
        <field name="principal_key" type="row"/>
        <field name="tool" type="row"/>
        <field name="outcome" type="col"/>
        <field name="calls" type="measure"/>
        <field name="avg_duration_ms" type="measure"/>
      </pivot>
    </field>
  </record>
  <record id="mcp_audit_report_view_search" model="ir.ui.view">
    <field name="name">mcp.audit.report.search</field>
    <field name="model">mcp.audit.report</field>
    <field name="arch" type="xml">
      <search>
        <field name="principal_key"/>
        <field name="tool"/>
        <field name="model"/>
        <filter name="denied" string="Denied" domain="[('outcome','=','denied')]"/>
        <filter name="last30" string="Last 30 days"
                domain="[('date','>=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
        <group>
          <filter name="by_principal" string="Principal" context="{'group_by': 'principal_key'}"/>
          <filter name="by_model" string="Model" context="{'group_by': 'model'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_mcp_audit_report" model="ir.actions.act_window">
    <field name="name">MCP Analytics</field>
    <field name="res_model">mcp.audit.report</field>
    <field name="view_mode">graph,pivot</field>
  </record>
</odoo>

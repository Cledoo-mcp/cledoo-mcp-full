<odoo>
  <record id="mcp_approval_view_list" model="ir.ui.view">
    <field name="name">mcp.approval.list</field>
    <field name="model">mcp.approval</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" decoration-warning="state == 'pending'">
        <field name="create_date"/>
        <field name="principal_key"/>
        <field name="user_id"/>
        <field name="tool_name"/>
        <field name="state"/>
        <field name="approver_id"/>
        <field name="expires_at"/>
        <button name="action_approve" type="object" string="Approve"
                icon="fa-check" invisible="state != 'pending'"/>
        <button name="action_refuse" type="object" string="Refuse"
                icon="fa-times" invisible="state != 'pending'"/>
      </list>
    </field>
  </record>
  <record id="mcp_approval_view_form" model="ir.ui.view">
    <field name="name">mcp.approval.form</field>
    <field name="model">mcp.approval</field>
    <field name="arch" type="xml">
      <form create="false" edit="false">
        <header>
          <button name="action_approve" type="object" string="Approve"
                  class="btn-primary" invisible="state != 'pending'"/>
          <button name="action_refuse" type="object" string="Refuse"
                  invisible="state != 'pending'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="principal_key"/>
            <field name="user_id"/>
            <field name="tool_name"/>
            <field name="args_json" widget="ace" options="{'mode': 'json'}"/>
            <field name="expires_at"/>
            <field name="approver_id"/>
            <field name="executed"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_mcp_approval" model="ir.actions.act_window">
    <field name="name">MCP Approvals</field>
    <field name="res_model">mcp.approval</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

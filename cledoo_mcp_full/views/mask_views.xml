<odoo>
  <record id="mcp_mask_rule_view_list" model="ir.ui.view">
    <field name="name">mcp.mask.rule.list</field>
    <field name="model">mcp.mask.rule</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="model_name"/>
        <field name="field_name"/>
        <field name="strategy"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>
  <record id="action_mcp_mask_rule" model="ir.actions.act_window">
    <field name="name">Data privacy</field>
    <field name="res_model">mcp.mask.rule</field>
    <field name="view_mode">list</field>
  </record>
</odoo>

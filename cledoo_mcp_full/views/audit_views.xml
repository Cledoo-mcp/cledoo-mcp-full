<odoo>
  <record id="mcp_audit_log_view_list" model="ir.ui.view">
    <field name="name">mcp.audit.log.list</field>
    <field name="model">mcp.audit.log</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" default_order="id desc">
        <field name="create_date"/>
        <field name="principal_key"/>
        <field name="user_id"/>
        <field name="tool"/>
        <field name="model"/>
        <field name="operation"/>
        <field name="outcome" decoration-danger="outcome == 'denied'"
               decoration-warning="outcome == 'error'"/>
        <field name="code" optional="hide"/>
        <field name="duration_ms" optional="hide"/>
        <field name="remote_addr" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="mcp_audit_log_view_search" model="ir.ui.view">
    <field name="name">mcp.audit.log.search</field>
    <field name="model">mcp.audit.log</field>
    <field name="arch" type="xml">
      <search>
        <field name="principal_key"/>
        <field name="tool"/>
        <field name="model"/>
        <filter name="denied" string="Denied" domain="[('outcome','=','denied')]"/>
        <filter name="errors" string="Errors" domain="[('outcome','=','error')]"/>
        <group>
          <filter name="by_principal" string="Principal" context="{'group_by': 'principal_key'}"/>
          <filter name="by_tool" string="Tool" context="{'group_by': 'tool'}"/>
          <filter name="by_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_mcp_audit_log" model="ir.actions.act_window">
    <field name="name">MCP Audit</field>
    <field name="res_model">mcp.audit.log</field>
    <field name="view_mode">list</field>
  </record>
  <record id="mcp_audit_export_view_form" model="ir.ui.view">
    <field name="name">mcp.audit.export.form</field>
    <field name="model">mcp.audit.export</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="date_from"/>
          <field name="date_to"/>
          <field name="format"/>
          <field name="filename" invisible="not file"/>
          <field name="file" filename="filename" invisible="not file"/>
        </group>
        <footer>
          <button name="action_export" type="object" string="Export" class="btn-primary"/>
          <button special="cancel" string="Close"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_mcp_audit_export" model="ir.actions.act_window">
    <field name="name">Export audit trail</field>
    <field name="res_model">mcp.audit.export</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
